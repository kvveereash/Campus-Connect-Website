generator client {
  provider        = "prisma-client-js"
  // "native" for wherever `prisma generate` runs (a laptop, Netlify's Ubuntu
  // build image), plus the engine Netlify's functions need at runtime: they
  // run on Amazon Linux with OpenSSL 3. With only "native", the deployed
  // function had no engine it could load, and every query failed.
  binaryTargets   = ["native", "rhel-openssl-3.0.x"]
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider  = "postgresql"
  // The app's connection: Supabase's transaction-mode pooler, pinned to one
  // connection. Right for serverless request handling, and unusable for
  // migrations — the schema engine needs advisory locks and session state a
  // transaction-mode pooler does not carry, which is why `prisma migrate`
  // against this URL fails with a bare "Schema engine error".
  url       = env("DATABASE_URL")
  // Migrations and introspection go direct instead: the same host on 5432,
  // session mode, no pgbouncer flag. Only the CLI reads this; PrismaClient
  // never touches it, so leaving it unset breaks nothing at runtime.
  directUrl = env("DIRECT_URL")
}

// ── Enums ──

enum UserRole {
  USER
  ADMIN
  COLLEGE_ADMIN
}

enum RegistrationStatus {
  PENDING
  PENDING_PAYMENT
  CONFIRMED
  PAID
  COMPLETED
  CANCELLED
  WAITLISTED
}

enum ClubMemberRole {
  MEMBER
  ADMIN
}

enum NotificationType {
  EVENT_REMINDER
  EVENT_UPDATE
  EVENT_JOIN
  CLUB_INVITE
  CLUB_UPDATE
  CLUB_JOIN
  TEAM_REQUEST
  TEAM_CONNECT
  COMMENT
  BADGE_EARNED
  SYSTEM
  GENERAL
}

enum TeamRequestType {
  LOOKING_FOR_TEAM
  LOOKING_FOR_MEMBER
}

enum ConversationRole {
  MEMBER
  ADMIN
}

model User {
  id             String     @id @default(cuid())
  name           String
  email          String     @unique
  password       String
  department     String?
  year           String?
  avatar         String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  lastSeenAt     DateTime   @default(now())
  role           UserRole   @default(USER)
  collegeId      String?
  bio            String?
  resumeUrl      String?
  achievements   String?
  projects       String?
  portfolioLinks String?
  lockedUntil    DateTime?
  // Null until the address is confirmed. Nullable on purpose: every account
  // that existed before this column did is unverified rather than broken,
  // and nothing about signing in depends on it.
  emailVerified  DateTime?
  // Google's stable account id ("sub"), set on first Google sign-in.
  googleId       String?    @unique
  // The Monday email of what is coming up. Opt-in, and only ever sent to a
  // confirmed address; digestSentAt is claimed per run so a retry cannot double-send.
  weeklyDigest   Boolean    @default(false)
  digestSentAt   DateTime?
  auditLogs      AuditLog[] @relation("AuditActor")

  clubMemberships            ClubMember[]
  comments                   Comment[]
  conversationParticipations ConversationParticipant[]
  createdEvents              Event[]                   @relation("CreatedEvents")
  registrations              EventRegistration[]
  eventInterests             EventInterest[]
  eventReviews               EventReview[]
  messagesSent               Message[]
  triggeredNotifications     Notification[]            @relation("NotificationActor")
  notifications              Notification[]            @relation("UserNotifications")
  passwordResetTokens        PasswordResetToken[]
  emailVerificationTokens    EmailVerificationToken[]
  posts                      Post[]
  reactions                  Reaction[]
  organisedEvents            EventOrganiser[]
  clubApplications           ClubApplication[]
  reportsFiled               Report[]                  @relation("ReportsFiled")
  reportsResolved            Report[]                  @relation("ReportsResolved")
  pushSubscriptions          PushSubscription[]
  createdFests               Fest[]                    @relation("CreatedFests")
  volunteerSignups           VolunteerSignup[]

  teamRequests     TeamRequest[]
  college          College?      @relation(fields: [collegeId], references: [id])
  badges           UserBadge[]
  followedColleges College[]     @relation("FollowedColleges")
  interests        Interest[]    @relation("InterestToUser")
  skills           Skill[]       @relation("SkillToUser")

  deletedAt DateTime?

  @@index([email])
  @@index([collegeId])
  @@index([createdAt])
  @@index([deletedAt])
}

/// Single-use, time-limited email confirmation links. Same shape as
/// PasswordResetToken deliberately — the two have identical needs, and a
/// second pattern for the same job is a second thing to get wrong.
model EmailVerificationToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}

model Skill {
  id    String @id @default(cuid())
  name  String @unique
  users User[] @relation("SkillToUser")
}

model Interest {
  id    String @id @default(cuid())
  name  String @unique
  users User[] @relation("InterestToUser")
}

model College {
  id          String   @id @default(cuid())
  name        String
  location    String
  logo        String
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  clubs       Club[]
  events      Event[]
  students    User[]
  followers   User[]   @relation("FollowedColleges")
  fests       Fest[]
}

model Event {
  id                String              @id @default(cuid())
  title             String
  description       String
  date              DateTime
  venue             String
  category          String
  registrationCount Int                 @default(0)
  thumbnail         String?
  hostCollegeId     String
  creatorId         String?
  clubId            String?
  verified          Boolean             @default(false)
  rejectionReason   String?
  verifiedBy        String?
  verifiedAt        DateTime?
  price             Float               @default(0)
  // Seats. Null means no limit; when full, new sign-ups join the waitlist.
  capacity          Int?
  // The fest this event is part of, if any.
  festId            String?
  fest              Fest?               @relation(fields: [festId], references: [id], onDelete: SetNull)
  volunteerRoles    VolunteerRole[]
  views             EventView[]
  club              Club?               @relation(fields: [clubId], references: [id])
  creator           User?               @relation("CreatedEvents", fields: [creatorId], references: [id])
  hostCollege       College             @relation(fields: [hostCollegeId], references: [id])
  registrations     EventRegistration[]
  reviews           EventReview[]
  interests         EventInterest[]
  organisers        EventOrganiser[]
  teamRequests      TeamRequest[]

  deletedAt DateTime?

  @@index([hostCollegeId])
  @@index([date])
  @@index([category])
  @@index([creatorId])
  @@index([festId])
  @@index([deletedAt])
}

model EventReview {
  id        String   @id @default(cuid())
  rating    Int
  comment   String?
  userId    String
  eventId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
  @@index([eventId])
  @@index([userId])
}

/// "Interested": a one-tap save, lighter than registering. Shown on Home and
/// My events, and reminded the day before like a registration (claimed
/// through reminderSentAt the same way).
model EventInterest {
  id             String    @id @default(cuid())
  userId         String
  eventId        String
  createdAt      DateTime  @default(now())
  reminderSentAt DateTime?
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  event          Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
  @@index([eventId])
}

model EventRegistration {
  id             String             @id @default(cuid())
  userId         String
  eventId        String
  status         RegistrationStatus @default(PENDING)
  paymentId      String?
  amountPaid     Float?
  // Set when an organiser scans the attendee's ticket at the door.
  checkedInAt    DateTime?
  // Claimed by the day-before reminder run, so two overlapping runs cannot both send it.
  reminderSentAt DateTime?
  // Where the person found the event (board, whatsapp, calendar, embed...), for the organiser's numbers.
  source         String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  event          Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user           User               @relation(fields: [userId], references: [id])

  @@unique([userId, eventId])
  @@index([userId])
  @@index([eventId])
}

model Badge {
  id          String      @id @default(cuid())
  name        String      @unique
  description String
  icon        String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  users       UserBadge[]
}

model UserBadge {
  id         String   @id @default(cuid())
  dateEarned DateTime @default(now())
  userId     String
  badgeId    String
  badge      Badge    @relation(fields: [badgeId], references: [id])
  user       User     @relation(fields: [userId], references: [id])

  @@unique([userId, badgeId])
}

model Club {
  id               String            @id @default(cuid())
  name             String
  description      String
  logo             String?
  category         String
  collegeId        String
  verified         Boolean           @default(false)
  rejectionReason  String?
  verifiedBy       String?
  verifiedAt       DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  college          College           @relation(fields: [collegeId], references: [id])
  members          ClubMember[]
  events           Event[]
  posts            Post[]
  // Recruitment: open or closed, and the questions applicants answer (JSON array of strings).
  recruiting       Boolean           @default(false)
  recruitQuestions Json?
  applications     ClubApplication[]
  fests            Fest[]
  deletedAt        DateTime?

  @@index([collegeId])
  @@index([deletedAt])
}

model ClubMember {
  id       String         @id @default(cuid())
  role     ClubMemberRole
  joinedAt DateTime       @default(now())
  userId   String
  clubId   String
  club     Club           @relation(fields: [clubId], references: [id])
  user     User           @relation(fields: [userId], references: [id])

  @@unique([userId, clubId])
  @@index([clubId]) // For getClubMembers()
  @@index([userId]) // For getUserMemberships()
}

model Post {
  id        String    @id @default(cuid())
  content   String
  image     String?
  likes     Int       @default(0)
  comments  Int       @default(0)
  timestamp DateTime  @default(now())
  authorId  String
  clubId    String
  replies   Comment[]
  author    User      @relation(fields: [authorId], references: [id])
  club      Club      @relation(fields: [clubId], references: [id])

  @@index([clubId, timestamp]) // For getClubPosts() sorted by date
  @@index([authorId]) // For getUserPosts()
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  timestamp DateTime @default(now())
  authorId  String
  postId    String
  author    User     @relation(fields: [authorId], references: [id])
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId]) // For getPostComments()
  @@index([authorId]) // For getUserComments()
}

model Notification {
  id          String           @id @default(cuid())
  message     String
  link        String?
  type        NotificationType
  read        Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  recipientId String
  actorId     String?
  actor       User?            @relation("NotificationActor", fields: [actorId], references: [id])
  recipient   User             @relation("UserNotifications", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId, createdAt]) // For getUserNotifications() sorted by date
  @@index([recipientId, read]) // For unread notification counts
}

model Conversation {
  id           String                    @id @default(cuid())
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @default(now())
  isGroup      Boolean                   @default(false)
  name         String?
  groupImage   String?
  participants ConversationParticipant[]
  messages     Message[]
}

model ConversationParticipant {
  id             String           @id @default(cuid())
  userId         String
  conversationId String
  lastReadAt     DateTime         @default(now())
  role           ConversationRole @default(MEMBER)
  conversation   Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id])

  @@unique([userId, conversationId])
  @@index([userId])
  @@index([conversationId])
}

model Message {
  id             String       @id @default(cuid())
  content        String
  attachmentUrl  String?
  attachmentType String?
  createdAt      DateTime     @default(now())
  senderId       String
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id])
  reactions      Reaction[]

  @@index([conversationId])
  @@index([senderId])
  @@index([createdAt])
}

model Reaction {
  id        String   @id @default(cuid())
  emoji     String
  messageId String
  userId    String
  createdAt DateTime @default(now())
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
}

model TeamRequest {
  id          String          @id @default(cuid())
  eventId     String
  creatorId   String
  creatorName String
  type        TeamRequestType
  skills      String
  description String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  creator     User            @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  event       Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId]) // For event team requests
  @@index([creatorId]) // For user's team requests
}

model AuditLog {
  id         String   @id @default(cuid())
  action     String
  entityType String
  entityId   String
  actorId    String
  details    Json?
  createdAt  DateTime @default(now())
  actor      User     @relation("AuditActor", fields: [actorId], references: [id])

  @@index([createdAt]) // For admin dashboard queries
  @@index([actorId]) // For user audit trail
  @@index([entityType, entityId]) // For entity history
}

model LoginAttempt {
  id        String   @id
  email     String
  success   Boolean
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([email, createdAt])
}

/// A co-organiser: can check people in, see attendees and announce, like the creator.
model EventOrganiser {
  id        String   @id @default(cuid())
  eventId   String
  userId    String
  createdAt DateTime @default(now())
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([userId])
}

enum ApplicationStatus {
  PENDING
  ACCEPTED
  DECLINED
}

/// A student applying to join a club while it is recruiting.
model ClubApplication {
  id        String            @id @default(cuid())
  clubId    String
  userId    String
  answers   Json
  status    ApplicationStatus @default(PENDING)
  createdAt DateTime          @default(now())
  decidedAt DateTime?
  club      Club              @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([clubId, userId])
  @@index([clubId, status])
}

enum ReportTarget {
  EVENT
  POST
  COMMENT
  CLUB
  USER
}

enum ReportReason {
  SPAM
  HARASSMENT
  INAPPROPRIATE
  MISLEADING
  OTHER
}

enum ReportStatus {
  OPEN
  ACTION_TAKEN
  DISMISSED
}

/// Something a user flagged for an admin to look at.
model Report {
  id           String       @id @default(cuid())
  reporterId   String
  targetType   ReportTarget
  targetId     String
  reason       ReportReason
  details      String?
  status       ReportStatus @default(OPEN)
  createdAt    DateTime     @default(now())
  resolvedAt   DateTime?
  resolvedById String?
  reporter     User         @relation("ReportsFiled", fields: [reporterId], references: [id], onDelete: Cascade)
  resolvedBy   User?        @relation("ReportsResolved", fields: [resolvedById], references: [id], onDelete: SetNull)

  // One report per person per thing: a second click updates nothing.
  @@unique([reporterId, targetType, targetId])
  @@index([status, createdAt])
}

/// A browser that agreed to receive push notifications for this user.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// A college fest: many events over a few days, shown as one timetable.
model Fest {
  id          String    @id @default(cuid())
  name        String
  tagline     String?
  description String
  startDate   DateTime
  endDate     DateTime
  coverImage  String?
  collegeId   String
  clubId      String?
  creatorId   String?
  // Like events and clubs, a fest is public once an admin approves it.
  verified    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  college     College   @relation(fields: [collegeId], references: [id])
  club        Club?     @relation(fields: [clubId], references: [id], onDelete: SetNull)
  creator     User?     @relation("CreatedFests", fields: [creatorId], references: [id], onDelete: SetNull)
  events      Event[]

  @@index([collegeId])
  @@index([startDate])
  @@index([deletedAt])
}

// A job an event needs people for: registration desk, stage, tech.
model VolunteerRole {
  id          String            @id @default(cuid())
  eventId     String
  name        String
  description String?
  slots       Int
  createdAt   DateTime          @default(now())
  event       Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  signups     VolunteerSignup[]

  @@index([eventId])
}

model VolunteerSignup {
  id        String        @id @default(cuid())
  roleId    String
  userId    String
  createdAt DateTime      @default(now())
  role      VolunteerRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roleId, userId])
  @@index([userId])
}

// Page views per event per day per source. Counted, never per person.
model EventView {
  eventId String
  day     DateTime @db.Date
  source  String
  count   Int      @default(0)
  event   Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@id([eventId, day, source])
}
