# Campus Connect — environment variables
#
# Local setup:  copy this file to `.env` and fill in real values.
# Production:   set the same variables in Netlify
#               (Site settings → Environment variables). They are read at
#               runtime, so never hardcode them into the source.
#
# `.env` is gitignored. Never commit real secrets.

# ── Database (required) ──
# Supabase → Project settings → Database → Connection string → Transaction pooler.
# URL-encode any special characters in the password (@ becomes %40).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&connection_limit=1"
# Same database, direct/session-mode connection (port 5432, no pgbouncer flag).
# Used only by the Prisma CLI: `prisma migrate` cannot run through the
# transaction-mode pooler above. Not needed at runtime or to build.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# ── Auth (required) ──
# Must be at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=""

# ── Realtime chat — Pusher (required) ──
# https://dashboard.pusher.com → your app → App Keys
PUSHER_APP_ID=""
PUSHER_SECRET=""
NEXT_PUBLIC_PUSHER_KEY=""
NEXT_PUBLIC_PUSHER_CLUSTER="ap2"

# ── Payments — Stripe (required for paid events) ──
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# ── Rate limiting — Upstash Redis (optional) ──
# Without these, rate limiting is skipped in development and fails open in
# production. Set them before going live.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ── Transactional email — Resend (optional) ──
# Needed for password-reset emails.
RESEND_API_KEY=""
EMAIL_FROM="Campus Connect <noreply@yourdomain.com>"

# ── App ──
NEXT_PUBLIC_APP_URL="http://localhost:3000"
